# Código de acceso a la app (elige uno largo). Obligatorio en producción.
APP_TOKEN=
# Railway lo rellena solo al añadir Postgres: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Contacto para el servicio de notificaciones push (mailto:tu@correo)
VAPID_SUBJECT=mailto:
# Opcional: claves VAPID fijas. Si no se ponen, se generan y se guardan en la base de datos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# IA (opcional): clave de https://openrouter.ai/keys. Sin ella la app funciona igual, con textos fijos.
OPENROUTER_API_KEY=
# Modelo de OpenRouter (por defecto anthropic/claude-haiku-4.5: rápido y barato)
OPENROUTER_MODEL=
# Máximo de llamadas a la IA por día (por defecto 80)
AI_DAILY_LIMIT=
